# TaskFlow Backend Configuration Example
# Copy this file to .env and enter your own credentials.
# Never commit your real .env file to GitHub.

PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/taskflow
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID.apps.googleusercontent.com

# Firebase Admin service-account JSON encoded as Base64.
# Keep the real value private.
FIREBASE_SERVICE_ACCOUNT=YOUR_BASE64_FIREBASE_SERVICE_ACCOUNT
