# Copy to .env for local development. On Render, set these as Environment Variables.
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
# The *Web application* OAuth client ID from Google Cloud (same one the Android app uses for requestIdToken)
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
